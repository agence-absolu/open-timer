<Window x:Class="OpenTimer.Views.PreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Préférences — OpenTimer"
        Width="460" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource Surface}">

    <StackPanel Margin="20">

        <TextBlock Text="CONNEXION" Style="{StaticResource SectionLabel}" />

        <TextBlock Text="URL de l'instance" Margin="0,8,0,2" />
        <TextBox x:Name="BaseUrlBox" />
        <TextBlock Text="Ex. https://openproject.exemple.fr" Style="{StaticResource Caption}" Margin="0,3,0,0" />

        <TextBlock Text="Token API" Margin="0,12,0,2" />
        <PasswordBox x:Name="TokenBox" Padding="6,5" />
        <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0"
                   Text="Mon compte → Jetons d'accès → API. Chiffré au repos (DPAPI)." />

        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
            <Button x:Name="TestButton" Content="Tester" Style="{StaticResource PrimaryButton}"
                    Click="OnTest" />
            <TextBlock x:Name="TestResult" VerticalAlignment="Center" Margin="12,0,0,0"
                       Style="{StaticResource Caption}" />
        </StackPanel>

        <Separator Margin="0,18" />

        <TextBlock Text="DÉMARRAGE" Style="{StaticResource SectionLabel}" />
        <CheckBox x:Name="LaunchAtLoginBox" Content="Lancer OpenTimer à l'ouverture de session"
                  Margin="0,6,0,0" Click="OnLaunchAtLoginToggled" />

        <TextBlock x:Name="ThemeTodo" Style="{StaticResource Caption}" Margin="0,14,0,0"
                   Text="Thème clair/sombre : à câbler (SettingsStore.Appearance existe déjà)." />

    </StackPanel>
</Window>
