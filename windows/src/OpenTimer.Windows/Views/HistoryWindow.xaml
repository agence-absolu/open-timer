<Window x:Class="OpenTimer.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Historique — OpenTimer"
        Width="620" Height="520" MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Surface}">

    <DockPanel Margin="18">

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="DERNIÈRES SAISIES" Style="{StaticResource SectionLabel}"
                       VerticalAlignment="Center" />
            <Button x:Name="ReloadButton" Content="Actualiser" Margin="12,0,0,0"
                    Style="{StaticResource PrimaryButton}" Click="OnReload" />
        </StackPanel>

        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Style="{StaticResource Caption}"
                   Margin="0,10,0,0" />

        <!-- TODO — parité macOS manquante : l'éditeur Début/Fin → Durée recalculée
             (TimeEntryEditView) et la suppression avec confirmation restent à porter.
             L'API C# expose déjà UpdateTimeEntryAsync / DeleteTimeEntryAsync. -->
        <ListView x:Name="EntriesList">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Date" Width="90" DisplayMemberBinding="{Binding DisplayDate}" />
                    <GridViewColumn Header="Durée" Width="70" DisplayMemberBinding="{Binding Duration}" />
                    <GridViewColumn Header="Work package" Width="260" DisplayMemberBinding="{Binding Title}" />
                    <GridViewColumn Header="Commentaire" Width="160" DisplayMemberBinding="{Binding Comment}" />
                </GridView>
            </ListView.View>
        </ListView>

    </DockPanel>
</Window>
